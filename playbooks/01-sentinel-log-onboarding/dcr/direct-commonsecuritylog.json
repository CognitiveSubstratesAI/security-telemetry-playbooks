{
  "kind": "Direct",
  "location": "westeurope",
  "properties": {
    "streamDeclarations": {
      "Custom-CommonSecurityLog": {
        "columns": [
          {
            "name": "TimeGenerated",
            "type": "datetime"
          },
          {
            "name": "DeviceVendor",
            "type": "string"
          },
          {
            "name": "DeviceProduct",
            "type": "string"
          },
          {
            "name": "DeviceVersion",
            "type": "string"
          },
          {
            "name": "Activity",
            "type": "string"
          },
          {
            "name": "LogSeverity",
            "type": "string"
          },
          {
            "name": "SourceIP",
            "type": "string"
          },
          {
            "name": "SourcePort",
            "type": "int"
          },
          {
            "name": "DestinationIP",
            "type": "string"
          },
          {
            "name": "DestinationPort",
            "type": "int"
          },
          {
            "name": "SourceUserName",
            "type": "string"
          },
          {
            "name": "DeviceAction",
            "type": "string"
          },
          {
            "name": "Message",
            "type": "string"
          }
        ]
      }
    },
    "destinations": {
      "logAnalytics": [
        {
          "name": "sentinelWorkspace",
          "workspaceResourceId": "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.OperationalInsights/workspaces/<ws>"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Custom-CommonSecurityLog"
        ],
        "destinations": [
          "sentinelWorkspace"
        ],
        "transformKql": "source | extend TimeGenerated = coalesce(TimeGenerated, now())",
        "outputStream": "Microsoft-CommonSecurityLog"
      }
    ]
  }
}
